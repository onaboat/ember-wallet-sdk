# Public sandbox authority
EMBER_CONFORMANCE_BASE_URL=https://REPLACE_WITH_QA_API_ORIGIN
EMBER_CONFORMANCE_ENVIRONMENT=sandbox
EMBER_CONFORMANCE_INTEGRATION_ID=integration_reference-wallet
EMBER_CONFORMANCE_INTEGRATION_VERSION=1
EMBER_CONFORMANCE_OFFER_ID=offer_devnet-qa-core-annual

# Use the exact registered host identity for this run.
EMBER_CONFORMANCE_HOST_KIND=native
EMBER_CONFORMANCE_HOST_ID=REPLACE_WITH_REGISTERED_APPLICATION_ID

# Absolute path outside this repository. Never commit wallet keys or seeds.
EMBER_CONFORMANCE_FIXTURE_MODULE=/secure/path/ember-conformance-wallet.mjs

# Required explicit approval. The runner rejects production/mainnet.
EMBER_CONFORMANCE_TRANSACTION_APPROVAL=REPLACE_AFTER_HUMAN_APPROVAL

# Optional polling policy.
EMBER_CONFORMANCE_POLL_INTERVAL_MS=2000
EMBER_CONFORMANCE_STATE_TIMEOUT_MS=120000
