{
  "name": "@embercover/wallet-sdk",
  "version": "1.3.2-beta.1",
  "description": "Secretless browser-extension and React Native client for Ember Cover",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "contract/README.md",
    "contract/provenance.json",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/onaboat/ember-wallet-sdk.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "boundary:check": "node scripts/check-public-boundary.mjs",
    "contract:check": "node scripts/check-contract-provenance.mjs && npm run generate:check",
    "consumer:check": "npm run build && node scripts/check-consumers.mjs",
    "conformance:api": "node scripts/run-api-conformance.mjs",
    "generate": "openapi-ts",
    "generate:check": "node scripts/check-generated.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "examples:check": "tsc --noEmit --project examples/tsconfig.json",
    "scan:public": "npm run build && npm run boundary:check && node scripts/check-bundle-secrets.mjs",
    "sbom": "node scripts/write-sbom.mjs",
    "pack:check": "npm run build && node scripts/check-package-contents.mjs",
    "release:check": "node scripts/check-release-ref.mjs",
    "verify": "npm run contract:check && npm run typecheck && npm test && npm run examples:check && npm run consumer:check && npm run scan:public && npm run pack:check",
    "prepack": "npm run build && npm run boundary:check && node scripts/check-bundle-secrets.mjs",
    "prepublishOnly": "npm run verify"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "postcss": "8.5.23"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "25.9.3",
    "msw": "^2.14.6",
    "tsup": "8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
